{
  "name": "@crimson-copies/orders-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:postgres": "tsx src/db/migrate.postgres.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:postgres": "tsx src/db/seed.postgres.ts",
    "db:transfer": "tsx src/db/transfer-mysql-to-postgres.ts"
  },
  "dependencies": {
    "@crimson-copies/shared": "workspace:*",
    "@fastify/multipart": "^8.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^4.29.0",
    "google-auth-library": "^11.0.2",
    "minio": "^8.0.7",
    "mysql2": "^3.11.5",
    "pg": "^8.16.3",
    "ws": "^8.22.0",
    "zod": "^4.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}