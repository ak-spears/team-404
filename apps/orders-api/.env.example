# --- apps/orders-api ---
# Full MySQL connection string for Drizzle/mysql2. Matches docker-compose's mysql service by
# default (see the repo-root .env.example).
DATABASE_URL=mysql://crimson_copies:devpassword@localhost:3306/crimson_copies
# Host/port orders-api binds to. Keep 127.0.0.1 outside containers -- orders-api is never
# reverse-proxied publicly.
HOST=127.0.0.1
PORT=4000
# Shared secret the storefront/staff-console BFFs send as X-Internal-Key. Generate a real
# random value per environment; this is a dev-only placeholder. Must match every other
# service's INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=dev-internal-key-change-me
# Where orders-api POSTs /internal/send. notify is a stub until real SMTP is wired --
# fire-and-forget either way.
NOTIFY_URL=http://127.0.0.1:4100
# bcrypt cost factor for SFTP upload-credential and user password hashing.
BCRYPT_ROUNDS=10
# Display-only values used to build the uploadInstructions block returned by POST /api/orders.
# Nothing listens here yet -- the storefront shows a "coming soon" placeholder instead of these
# credentials in the meantime.
FILE_INTAKE_HOST=localhost
FILE_INTAKE_PORT=2222
