# --- orders-api BFF (server-only) ---
ORDERS_API_URL=http://127.0.0.1:4000
# Must match orders-api's INTERNAL_API_KEY exactly (see apps/orders-api/.env.example).
INTERNAL_API_KEY=dev-internal-key-change-me
# Signs the session cookie (see src/lib/session.ts). Generate a real random value per
# environment; this is a dev-only placeholder. Unique to this app -- never share it with
# storefront's SESSION_SECRET.
SESSION_SECRET=dev-staff-console-session-secret-change-me

# --- Main site link ("Home" in the header, and where logout lands) ---
# On the VM the storefront is "/" on this same hostname (Caddy). Local dev runs the two apps
# on separate ports with no proxy, so point this at the storefront directly:
#   STOREFRONT_URL=http://localhost:3000/
STOREFRONT_URL=/

# --- MinIO (server-only -- presigned GET links for staff file viewing) ---
# Matches docker-compose's minio service. staff-console only needs read access to the
# order-files bucket to mint short-lived presigned GET URLs; it never writes to MinIO itself.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=order-files
