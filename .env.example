# --- MySQL (docker-compose infra) ---
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=crimson_copies
MYSQL_USER=crimson_copies
MYSQL_PASSWORD=devpassword
MYSQL_PORT=3306

# --- MinIO (docker-compose infra) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit (docker-compose infra) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- apps/orders-api ---
# Full MySQL connection string for Drizzle/mysql2. Matches the compose values above by default.
DATABASE_URL=mysql://crimson_copies:devpassword@localhost:3306/crimson_copies
# Host/port orders-api binds to. Keep 127.0.0.1 outside containers -- orders-api is never
# reverse-proxied publicly.
HOST=127.0.0.1
PORT=4000
# Shared secret the storefront/staff-console BFFs (and file-intake, later round) send as
# X-Internal-Key. Generate a real random value per environment; this is a dev-only placeholder.
INTERNAL_API_KEY=dev-internal-key-change-me
# Where orders-api POSTs /internal/send. notify is a stub until real SMTP is wired --
# fire-and-forget either way.
NOTIFY_URL=http://127.0.0.1:4100
# bcrypt cost factor for SFTP upload-credential and user password hashing.
BCRYPT_ROUNDS=10
# Display-only values used to build the uploadInstructions block returned by POST /api/orders.
# Nothing listens here yet -- the storefront shows a "coming soon" placeholder instead of these
# credentials in the meantime.
FILE_INTAKE_HOST=localhost
FILE_INTAKE_PORT=2222

# --- Google OAuth (storefront + orders-api) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-session-secret-change-me

# --- cross-app navigation links ---
# The staff console is served at the /staff path prefix on the team's single hostname (Caddy
# routes it; a staff. subdomain can't get a TLS cert). These defaults are correct on the VM.
# Local dev runs the two apps on separate ports with no proxy -- override as shown.
#
# storefront: where the "Staff sign in" header link points.
STAFF_CONSOLE_URL=/staff
#   local dev: STAFF_CONSOLE_URL=http://localhost:3001/staff
#
# staff-console: the main site ("Home" in the header, and where logout lands).
STOREFRONT_URL=/
#   local dev: STOREFRONT_URL=http://localhost:3000/
