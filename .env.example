# Crimson Copies -- local dev environment.
#
# Copy this file to each service that needs it and fill in the blanks:
#   cp .env.example .env                       # docker-compose reads the infra vars
#   cp .env.example apps/orders-api/.env
#   cp .env.example apps/storefront/.env
#   cp .env.example apps/staff-console/.env
#   cp services/notify/.env.example services/notify/.env
# Every value below is a working dev placeholder -- the app boots as-is. Real deployments
# override the secrets. .env files are gitignored; never commit one.
#
# INTERNAL_API_KEY must be the SAME string in orders-api, storefront, staff-console and
# notify, or the BFF calls between them 401.


# ============================================================================
# docker-compose infra (root .env only)
# ============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=crimson_copies
MYSQL_USER=crimson_copies
MYSQL_PASSWORD=devpassword
# Host port the container publishes. If something already owns 3306 on your machine
# (e.g. a native MySQL), set this to 3307 here AND in apps/orders-api/.env's DATABASE_URL.
MYSQL_PORT=3306

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# ============================================================================
# apps/orders-api/.env
# ============================================================================

# MySQL connection string for Drizzle/mysql2. Matches the compose values above.
# If you changed MYSQL_PORT, change the port here too.
DATABASE_URL=mysql://crimson_copies:devpassword@localhost:3306/crimson_copies
# Host/port orders-api binds to. Keep 127.0.0.1 -- orders-api is never public.
HOST=127.0.0.1
PORT=4000
# Shared secret the storefront/staff-console BFFs send as X-Internal-Key. Must match
# the value in every other service's .env. Dev-only placeholder.
INTERNAL_API_KEY=dev-internal-key-change-me
# Where orders-api POSTs /internal/send. notify is a stub -- fire-and-forget.
NOTIFY_URL=http://127.0.0.1:4100
# bcrypt cost factor for SFTP upload-credential and user password hashing.
BCRYPT_ROUNDS=10
# Display-only values for the uploadInstructions block returned by POST /api/orders.
# Nothing listens on the other end yet.
FILE_INTAKE_HOST=localhost
FILE_INTAKE_PORT=2222
# Google OAuth -- orders-api verifies the code server-side (see routes/internal.ts).
# Password sign-in works with these placeholders; only the "Sign in with Google"
# button needs a real OAuth client from https://console.cloud.google.com/apis/credentials .
# Use the SAME GOOGLE_CLIENT_ID in apps/storefront/.env.
GOOGLE_CLIENT_ID=dev-google-client-id-not-configured
GOOGLE_CLIENT_SECRET=dev-google-client-secret-not-configured


# ============================================================================
# apps/storefront/.env
# ============================================================================

# Internal-only orders-api listener (server-side BFF calls). Has a sane default; set
# it only if orders-api isn't on 127.0.0.1:4000.
ORDERS_API_URL=http://127.0.0.1:4000
# Must match orders-api's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key-change-me
# Signs this app's session cookie. Unique to storefront -- do NOT reuse staff-console's.
SESSION_SECRET=dev-storefront-session-secret-change-me
# Same Google OAuth client id as orders-api (public half; no secret in the storefront).
GOOGLE_CLIENT_ID=dev-google-client-id-not-configured
# This app's own public origin -- used to build the Google redirect_uri
# (${APP_BASE_URL}/auth/google/callback). On the VM: https://<team>.capstone.uamishub.com
APP_BASE_URL=http://localhost:3000


# ============================================================================
# apps/staff-console/.env
# ============================================================================

ORDERS_API_URL=http://127.0.0.1:4000
# Must match orders-api's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key-change-me
# Signs this app's session cookie. Unique to staff-console -- do NOT reuse storefront's.
SESSION_SECRET=dev-staff-console-session-secret-change-me
# MinIO -- staff-console mints short-lived presigned GET links for uploaded files.
# Defaults match the compose service; override for a real deploy.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=order-files


# ============================================================================
# cross-app navigation links (storefront + staff-console) -- usually leave unset
# ============================================================================
# staff-console is served at the /staff path prefix on the team's single hostname
# (Caddy routes it; a staff. subdomain can't get a TLS cert). Both settings auto-detect:
#   NODE_ENV=production -> "/staff" and "/"  (relative -- Caddy bridges the two apps)
#   otherwise           -> http://localhost:3001/staff and http://localhost:3000/
# Set these only for a non-standard setup (different ports, a different host layout).
#
# STAFF_CONSOLE_URL=http://localhost:3001/staff   # storefront -> staff console link
# STOREFRONT_URL=http://localhost:3000/           # staff console "Home" + post-logout
