# Crimson Copies -- local dev environment.
#
# Copy this file to each service that needs it and fill in the blanks:
#   cp .env.example .env                       # docker-compose reads the infra vars
#   cp .env.example apps/orders-api/.env
#   cp .env.example apps/storefront/.env
#   cp .env.example apps/staff-console/.env
#   cp services/notify/.env.example services/notify/.env
# Every value below is a working dev placeholder -- the app boots as-is. Real deployments
# override the secrets. .env files are gitignored; never commit one.
#
# INTERNAL_API_KEY must be the SAME string in orders-api, storefront, staff-console and
# notify, or the BFF calls between them 401.


# ============================================================================
# docker-compose infra (root .env only)
# ============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=crimson_copies
MYSQL_USER=crimson_copies
MYSQL_PASSWORD=devpassword
# Host port the container publishes. If something already owns 3306 on your machine
# (e.g. a native MySQL), set this to 3307 here AND in apps/orders-api/.env's DATABASE_URL.
MYSQL_PORT=3306

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# ============================================================================
# apps/orders-api/.env
# ============================================================================

# Postgres/Neon connection string for Drizzle (drizzle-orm/neon-serverless). orders-api's
# server.ts now boots the Postgres stack (src/app.postgres.ts) -- the docker-compose MySQL
# service above is legacy and no longer what orders-api actually connects to. Get a real
# connection string from the team's Neon project dashboard (console.neon.tech) -- ask a
# teammate for access if you don't have it. Looks like:
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
# Host/port orders-api binds to. Keep 127.0.0.1 -- orders-api is never public.
HOST=127.0.0.1
PORT=4000
# Shared secret the storefront/staff-console BFFs send as X-Internal-Key. Must match
# the value in every other service's .env. Dev-only placeholder.
INTERNAL_API_KEY=dev-internal-key-change-me
# Where orders-api POSTs /internal/send. notify is a stub -- fire-and-forget.
NOTIFY_URL=http://127.0.0.1:4100
# bcrypt cost factor for SFTP upload-credential and user password hashing.
BCRYPT_ROUNDS=10
# Display-only values for the uploadInstructions block returned by POST /api/orders.
# Nothing listens on the other end yet.
FILE_INTAKE_HOST=localhost
FILE_INTAKE_PORT=2222
# Google OAuth -- orders-api verifies the code server-side (see routes/internal.ts).
# Password sign-in works with these placeholders; only the "Sign in with Google"
# button needs a real OAuth client from https://console.cloud.google.com/apis/credentials .
# Use the SAME GOOGLE_CLIENT_ID in apps/storefront/.env.
GOOGLE_CLIENT_ID=dev-google-client-id-not-configured
GOOGLE_CLIENT_SECRET=dev-google-client-secret-not-configured

# --- MinIO (orders-api writes uploads here; staff-console reads them back) ---
# Matches the docker-compose minio service above. orders-api creates the bucket at boot if it
# is missing, so no manual setup step. Override the credentials in a real deployment -- on the
# VM these live in /etc/capstone/env/orders-api.env.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=order-files

# --- Google OAuth (storefront + staff-console + orders-api) ---
# staff-console also reads GOOGLE_CLIENT_ID and APP_BASE_URL (for its own "Sign in with
# Google" button/callback) -- override APP_BASE_URL to its own port in local dev, e.g.
# APP_BASE_URL=http://localhost:3001 in apps/staff-console/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-session-secret-change-me

# --- cross-app navigation links ---
# The staff console is served at the /staff path prefix on the team's single hostname (Caddy
# routes it; a staff. subdomain can't get a TLS cert). These defaults are correct on the VM.
# Local dev runs the two apps on separate ports with no proxy -- override as shown.
#
# storefront: where the "Staff sign in" header link points.
STAFF_CONSOLE_URL=/staff
#   local dev: STAFF_CONSOLE_URL=http://localhost:3001/staff
#
# STAFF_CONSOLE_URL=http://localhost:3001/staff   # storefront -> staff console link
# STOREFRONT_URL=http://localhost:3000/           # staff console "Home" + post-logout


# ============================================================================
# apps/staff-console/.env and apps/storefront/.env -- MinIO download links
# ============================================================================

# Both web apps mint short-lived presigned GET links: staff-console so staff can open an
# uploaded file, the storefront so a customer can check they sent the right version. Both
# READ ONLY: orders-api is the sole writer, so give this app its own scoped account rather
# than the root credentials above. Create it once against your MinIO:
#
#   mc admin policy create local order-files-read ./policy.json   # s3:GetObject on order-files/*
#   mc admin user add local staff-console <secret>
#   mc admin policy attach local order-files-read --user staff-console
#
# Give the storefront its own account against the same policy -- separate credentials mean
# a leak in one app can be revoked without touching the other:
#   mc admin user add local storefront <secret>
#   mc admin policy attach local order-files-read --user storefront
#
# MINIO_ACCESS_KEY=staff-console
# MINIO_SECRET_KEY=<the secret you generated>

# Where the presigned link POINTS -- the staff browser's view of MinIO, which is not the
# address staff-console itself connects to. SigV4 signs the Host header, so a link signed for
# 127.0.0.1 cannot be rewritten to the public host afterwards. Leave unset in local dev (the
# browser reaches MinIO directly); on the VM, Caddy proxies /order-files/* to MinIO:
#
# MINIO_PUBLIC_ENDPOINT=team-404.capstone.uamishub.com
# MINIO_PUBLIC_USE_SSL=true
#   MINIO_PUBLIC_PORT defaults to 443/80 to match, so it rarely needs setting.
