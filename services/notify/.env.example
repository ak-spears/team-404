# --- services/notify ---
# Host/port notify binds to. Internal-only -- never reverse-proxied publicly.
HOST=127.0.0.1
PORT=4100
# Shared secret orders-api sends as X-Internal-Key. Must match every other service's
# INTERNAL_API_KEY exactly. Generate a real random value per environment; this is a dev-only
# placeholder.
INTERNAL_API_KEY=dev-internal-key-change-me
